# Copy to .env. Never commit the actual .env or OAuth secrets.
# Use the same origin in the browser and in both provider dashboards.
DAUYS_PUBLIC_URL=http://127.0.0.1:8765
DAUYS_GOOGLE_CLIENT_ID=
DAUYS_GOOGLE_CLIENT_SECRET=
DAUYS_FACEBOOK_CLIENT_ID=
DAUYS_FACEBOOK_CLIENT_SECRET=
# Set this to a supported version shown in your Meta dashboard.
DAUYS_FACEBOOK_API_VERSION=v23.0
